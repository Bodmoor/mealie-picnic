<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>mealie-picnic</UserSecretsId>
  </PropertyGroup>

  <!-- The Dockerfile lives at the repository root because its build context needs
       to reach src/. These point Visual Studio's container tooling at it. -->
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileFile>..\..\Dockerfile</DockerfileFile>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <!-- The PWA icons ship inside the assembly, so there is no wwwroot to deploy
       and nothing to keep in sync next to the DLL. LogicalName must match the
       names Icons.Load() looks up. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon-192.png"
                      LogicalName="MealiePicnic.assets.icon-192.png" />
    <EmbeddedResource Include="..\..\assets\icon-512.png"
                      LogicalName="MealiePicnic.assets.icon-512.png" />
    <EmbeddedResource Include="..\..\assets\icon-maskable-512.png"
                      LogicalName="MealiePicnic.assets.icon-maskable-512.png" />
  </ItemGroup>

  <!-- Surface the root-level infra files in Solution Explorer so they are
       editable without leaving the IDE. Link keeps them out of subfolders. -->
  <ItemGroup>
    <None Include="..\..\Dockerfile" Link="Dockerfile" />
    <None Include="..\..\.dockerignore" Link=".dockerignore" />
    <None Include="..\..\docker-compose.yml" Link="docker-compose.yml" />
    <None Include="..\..\docker-compose.deploy.yml" Link="docker-compose.deploy.yml" />
    <None Include="..\..\.env.example" Link=".env.example" />
    <None Include="..\..\README.md" Link="README.md" />
  </ItemGroup>

</Project>
