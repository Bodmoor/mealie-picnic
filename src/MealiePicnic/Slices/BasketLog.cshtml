@inherits RazorSlice<BasketLogModel>
@{
    var t = AppText.Current;
}
@if (Model.Results.Count == 0)
{
    <div class="muted">@t.BasketNothingLinked</div>
}
else
{
    foreach (var r in Model.Results)
    {
        if (r.Ok)
        {
            <div class="ok">
                @* Parenthesised on purpose (issue #52). Razor leaves anything
                   shaped like an email address alone so a literal one needs no
                   escaping, and `x@@r.Amount` fits that shape -- local part `x`,
                   domain `r.Amount` -- so it rendered as its own source text.
                   `@@(...)` is an explicit expression and cannot be read that way. *@
                &check; @r.Name x@(r.Amount)
                @if (Model.CheckOff && !r.CheckedOff)
                {
                    <span class="muted">@t.BasketInCartNotCheckedOff</span>
                }
            </div>
        }
        else
        {
            <div class="bad">&times; @r.Name: @r.Error <span class="muted">&mdash; @t.BasketStaysOnList</span></div>
        }
    }
}
@if (Model.Aborted)
{
    <div class="bad">@t.BasketRequestFailed</div>
}
@if (Model.Unmapped > 0)
{
    <div class="muted">@t.BasketNotLinkedYet(Model.Unmapped)</div>
}
