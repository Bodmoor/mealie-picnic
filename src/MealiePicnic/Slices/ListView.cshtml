@inherits RazorSlice<ListViewModel>
@{
    var t = AppText.Current;
    var open = Model.Items.Where(i => !i.Checked).ToList();
    var fresh = open.Where(i => i.State == LinkState.New).ToList();
    var linked = open.Where(i => i.State == LinkState.Linked).ToList();
    var excluded = open.Where(i => i.State == LinkState.Excluded).ToList();
    var done = Model.Items.Where(i => i.Checked).ToList();

    void Tag(LinkState state)
    {
        if (state == LinkState.New)
        {
            <span class="tag new">@t.TagNew</span>
        }
        else if (state == LinkState.Linked)
        {
            <span class="tag linked">@t.TagLinked</span>
        }
        else
        {
            <span class="tag">@t.TagNotAtPicnic</span>
        }
    }

    void ItemRow(ShoppingItem it)
    {
        var sub = it.State == LinkState.Linked
            ? $"{(string.IsNullOrEmpty(it.PicnicLabel) ? it.PicnicUid : it.PicnicLabel)} · {it.AmountReason}"
            : it.Display;
        <div class="item" hx-get="@($"/api/items/{it.FoodId}?listId={Uri.EscapeDataString(Model.CurrentListId)}")" hx-target="#view" hx-swap="outerHTML" hx-push-url="true">
            <div>
                <div class="name">@it.FoodName</div>
                <div class="sub">@sub@(string.IsNullOrEmpty(it.Label) ? "" : $" · {it.Label}")</div>
            </div>
            @{ Tag(it.State); }
        </div>
    }
}
<div id="view" x-data="{ showExcluded: false }">
    @* Three groups, because there are three separate concerns here (issue #56):
       which list, what to do with it, and what to show. Grouping them in the
       markup is what lets the browser break BETWEEN them instead of through
       them -- the previous single flex row left the basket button's own
       checkbox stranded beside an unrelated one. The form keeps
       display:contents so its button and option sit in the group's flex flow
       while still submitting together. *@
    <div class="toolbar">
        <div class="group">
            <select name="listId" title="@t.MealieListPicker"
                    hx-post="/api/lists/select" hx-target="#view" hx-swap="outerHTML">
                @foreach (var l in Model.Lists)
                {
                    <option value="@l.Id" @(l.Id == Model.CurrentListId ? "selected" : "")>@l.Name</option>
                }
            </select>
            <button class="primary" hx-get="@($"/api/list?listId={Uri.EscapeDataString(Model.CurrentListId)}")"
                    hx-target="#view" hx-swap="outerHTML">@t.FetchMealieList</button>
        </div>

        <div class="group">
            <form style="display:contents" hx-post="/api/basket" hx-target="#basketlog" hx-swap="innerHTML">
                <input type="hidden" name="listId" value="@Model.CurrentListId">
                <button type="submit">@t.AddAllToBasket</button>
                <label class="chk"><input type="checkbox" name="checkOff" value="true" checked> @t.CheckOffInMealie</label>
            </form>
        </div>

        <div class="group">
            <label class="chk"><input type="checkbox" x-model="showExcluded"> @t.ShowExcluded</label>
        </div>
    </div>
    <div id="basketlog" class="log"></div>

    @if (fresh.Count > 0)
    {
        <h2>@t.HeadingNew(fresh.Count)</h2>
        @foreach (var it in fresh) { ItemRow(it); }
    }

    @if (linked.Count > 0)
    {
        <h2>@t.HeadingLinked(linked.Count)</h2>
        @foreach (var it in linked) { ItemRow(it); }
    }

    @if (excluded.Count > 0)
    {
        <div x-show="showExcluded" x-cloak>
            <h2>@t.HeadingNotAtPicnic(excluded.Count)</h2>
            @foreach (var it in excluded)
            {
                <div class="item">
                    <div>
                        <div class="name">@it.FoodName</div>
                        <div class="sub">@t.TagExcluded</div>
                    </div>
                    <button class="tag" hx-post="@($"/api/include?listId={Uri.EscapeDataString(Model.CurrentListId)}")"
                            hx-vals='{"foodId":"@it.FoodId"}'
                            hx-target="#view" hx-swap="outerHTML">@t.Restore</button>
                </div>
            }
        </div>
    }

    @if (done.Count > 0)
    {
        <details class="done-block">
            <summary>@t.HeadingDone(done.Count)</summary>
            @foreach (var it in done)
            {
                <div class="item done-item">
                    <div>
                        <div class="name">@it.FoodName</div>
                        <div class="sub">@(string.IsNullOrEmpty(it.PicnicLabel) ? (string.IsNullOrEmpty(it.PicnicUid) ? it.Display : it.PicnicUid) : it.PicnicLabel)</div>
                    </div>
                    <span class="tag">@t.TagCheckedOff</span>
                </div>
            }
        </details>
    }

    @if (Model.Items.Count == 0)
    {
        <p class="muted">@t.ListEmpty</p>
    }
    @if (Model.Items.Count > 0 && open.Count == 0)
    {
        <p class="muted">@t.ListAllCheckedOff</p>
    }
</div>
