@inherits RazorSlice<ListViewModel>
@{
    var open = Model.Items.Where(i => !i.Checked).ToList();
    var fresh = open.Where(i => i.State == LinkState.New).ToList();
    var linked = open.Where(i => i.State == LinkState.Linked).ToList();
    var excluded = open.Where(i => i.State == LinkState.Excluded).ToList();
    var done = Model.Items.Where(i => i.Checked).ToList();

    void Tag(LinkState state)
    {
        if (state == LinkState.New)
        {
            <span class="tag new">nieuw</span>
        }
        else if (state == LinkState.Linked)
        {
            <span class="tag linked">gekoppeld</span>
        }
        else
        {
            <span class="tag">niet bij Picnic</span>
        }
    }

    void ItemRow(ShoppingItem it)
    {
        var sub = it.State == LinkState.Linked
            ? $"{(string.IsNullOrEmpty(it.PicnicLabel) ? it.PicnicUid : it.PicnicLabel)} · {it.AmountReason}"
            : it.Display;
        <div class="item" hx-get="@($"/api/items/{it.FoodId}?listId={Uri.EscapeDataString(Model.CurrentListId)}")" hx-target="#view" hx-swap="outerHTML">
            <div>
                <div class="name">@it.FoodName</div>
                <div class="sub">@sub@(string.IsNullOrEmpty(it.Label) ? "" : $" · {it.Label}")</div>
            </div>
            @{ Tag(it.State); }
        </div>
    }
}
<div id="view" x-data="{ showExcluded: false }">
    <div class="bar">
        <select name="listId" title="Mealie lijst"
                hx-post="/api/lists/select" hx-target="#view" hx-swap="outerHTML">
            @foreach (var l in Model.Lists)
            {
                <option value="@l.Id" @(l.Id == Model.CurrentListId ? "selected" : "")>@l.Name</option>
            }
        </select>
        <button class="primary" hx-get="@($"/api/list?listId={Uri.EscapeDataString(Model.CurrentListId)}")"
                hx-target="#view" hx-swap="outerHTML">Haal Mealie lijst op</button>
        <form style="display:contents" hx-post="/api/basket" hx-target="#basketlog" hx-swap="innerHTML">
            <input type="hidden" name="listId" value="@Model.CurrentListId">
            <button type="submit">Alles in Picnic mand</button>
            <label class="chk"><input type="checkbox" name="checkOff" value="true" checked> afvinken in Mealie</label>
        </form>
        <label class="chk"><input type="checkbox" x-model="showExcluded"> toon uitgesloten</label>
    </div>
    <div id="basketlog" class="log"></div>

    @if (fresh.Count > 0)
    {
        <h2>Nieuw (@fresh.Count)</h2>
        @foreach (var it in fresh) { ItemRow(it); }
    }

    @if (linked.Count > 0)
    {
        <h2>Gekoppeld (@linked.Count)</h2>
        @foreach (var it in linked) { ItemRow(it); }
    }

    @if (excluded.Count > 0)
    {
        <div x-show="showExcluded" x-cloak>
            <h2>Niet bij Picnic (@excluded.Count)</h2>
            @foreach (var it in excluded)
            {
                <div class="item">
                    <div>
                        <div class="name">@it.FoodName</div>
                        <div class="sub">uitgesloten</div>
                    </div>
                    <button class="tag" hx-post="@($"/api/include?listId={Uri.EscapeDataString(Model.CurrentListId)}")"
                            hx-vals='{"foodId":"@it.FoodId"}'
                            hx-target="#view" hx-swap="outerHTML">terugzetten</button>
                </div>
            }
        </div>
    }

    @if (done.Count > 0)
    {
        <details class="done-block">
            <summary>Afgevinkt / toegevoegd aan mand (@done.Count)</summary>
            @foreach (var it in done)
            {
                <div class="item done-item">
                    <div>
                        <div class="name">@it.FoodName</div>
                        <div class="sub">@(string.IsNullOrEmpty(it.PicnicLabel) ? (string.IsNullOrEmpty(it.PicnicUid) ? it.Display : it.PicnicUid) : it.PicnicLabel)</div>
                    </div>
                    <span class="tag">afgevinkt</span>
                </div>
            }
        </details>
    }

    @if (Model.Items.Count == 0)
    {
        <p class="muted">Lijst is leeg.</p>
    }
    @if (Model.Items.Count > 0 && open.Count == 0)
    {
        <p class="muted">Alles op deze lijst is afgevinkt.</p>
    }
</div>
