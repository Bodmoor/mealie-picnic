# Copy to .env next to docker-compose.yml
# Minimum 16 characters; this is the only thing between the internet and a
# supermarket account that can place orders. Optional once BOODSCHAPPEN_OIDC_AUTHORITY
# below is set, where it still works as a break-glass fallback at /login/admin.
APP_PASSWORD=kies-iets-lang-minimaal-16-tekens

# OIDC login (e.g. Authentik), via this app's OWN dedicated application -- not
# Mealie's. Leave BOODSCHAPPEN_OIDC_AUTHORITY unset to keep the plain password
# login above. Who may sign in at all is controlled entirely by the
# provider/application's own group policy in Authentik, not by this app.
BOODSCHAPPEN_OIDC_AUTHORITY=https://authentik.your-domain.nl/application/o/boodschappen/
BOODSCHAPPEN_OIDC_CLIENT_ID=boodschappen
BOODSCHAPPEN_OIDC_CLIENT_SECRET=paste-the-confidential-client-secret

MEALIE_URL=https://mealie.your-domain.nl
MEALIE_TOKEN=paste-a-mealie-api-token
MEALIE_LIST=Boodschappen

PICNIC_USER=you@example.com
PICNIC_PASSWORD=your-picnic-password
PICNIC_COUNTRY=NL

SEARCH_CACHE_MINUTES=30

# Behind a TLS-terminating reverse proxy: set both to true.
COOKIE_SECURE=false
TRUST_PROXY=false
